# Copy to .env and fill in. .env is git-ignored -- NEVER commit real secrets.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- Mode ----
# aimfa    = full protection (attestation + DPoP tokens + monitor + human step-up)
# baseline = "the old way": gateway only checks a static API key (for attack comparison)
AIMFA_MODE=aimfa

# ---- Service URLs (localhost) ----
CONTROL_PLANE_URL=http://127.0.0.1:8000
GATEWAY_URL=http://127.0.0.1:8100
RESOURCES_URL=http://127.0.0.1:8200
DASHBOARD_URL=http://127.0.0.1:8501

# ---- Shared secrets (change all of these) ----
# Generated with python -c "import secrets; print(secrets.token_urlsafe(32))
# Admin key: used by the dashboard / setup scripts to call /admin/* on the control plane.
ADMIN_API_KEY=change-me-admin
# Gateway -> control plane internal endpoints (/internal/*).
INTERNAL_SERVICE_SECRET=change-me-internal
# Gateway -> mock resources. Agents never learn this, so they cannot bypass the gateway.
GATEWAY_RESOURCE_SECRET=change-me-resources
# Baseline mode only: the static "master API key" an agent would normally hold.
BASELINE_API_KEY=change-me-baseline

# ---- Storage ----
DATA_DIR=./var
KEYS_DIR=./keys

# ---- Token / proof lifetimes (seconds) ----
IDENTITY_TOKEN_TTL_SECONDS=3600
ACCESS_TOKEN_TTL_SECONDS=900
DPOP_MAX_AGE_SECONDS=60
ATTEST_NONCE_TTL_SECONDS=60
APPROVAL_TIMEOUT_SECONDS=300

# ---- Behavioral monitor ----
RISK_STEP_UP_THRESHOLD=50
RISK_REVOKE_THRESHOLD=80
RISK_DECAY_PER_MINUTE=5

# ---- Human step-up push notifications (ntfy.sh, free, no account) ----
# Pick a LONG random topic name; anyone who knows it can read the notifications.
# Notifications never contain secrets -- only "approval pending" + a dashboard link.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Set to false to disable push (approvals still work in the dashboard).
NTFY_ENABLED=true

# ---- LLM: TAMU AI (OpenAI-compatible API) ----
# Verified 2026-11-12 (ADR-0005). List the models your key can use with:
#   python scripts/check_tamu_ai.py --list
TAMU_AI_BASE_URL=https://chat-api.tamu.ai/openai
TAMU_AI_API_KEY=
TAMU_AI_MODEL=protected.Claude-Opus-5
